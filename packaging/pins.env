# Single source of truth for the pins shared by the .deb and Arch builds.
# Sourced by shell scripts. Rewritten by packaging/update-pins.sh.
# Every download below is verified with sha256sum and fails closed.

# crystal-alpha source release (GitHub tag archive, same tarball the Homebrew
# formula pins).
CRYSTAL_ALPHA_TAG=v1.21.0-incremental-1
CRYSTAL_ALPHA_COMMIT=9c1e8ec64f6be6343e90d3979bc9536c4b050292
CRYSTAL_ALPHA_SOURCE_SHA256=2c85084ce5ed4973d7f1f73987ba990b7b16381f60dd8ccc8a92b2bec1203b05
# Package version: the tag with hyphens replaced so it is legal in dpkg and
# pacman versions. 1.21.0.incremental1 sorts after upstream 1.21.0.
CRYSTAL_ALPHA_PKGVER=1.21.0.incremental1

# Bootstrap Crystal (official release, same one the Homebrew formula uses).
BOOT_VERSION=1.20.0-1
BOOT_RELEASE=1.20.0
BOOT_SHA256_X86_64=e7138481c02a38966e642d9c17550da62a2a18685d94e7841f763055990d91ee
BOOT_SHA256_AARCH64=4d4bb93c15ad0b2b766c2d244c1f0d2de2758e6382939e7a8d9fdf250fbf9afe
