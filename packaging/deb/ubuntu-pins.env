# Pins for the Ubuntu .deb build. Sourced by packaging/deb/lib.sh.
#
# Reproducibility model:
#   * Base image: pinned by the multi-arch index digest (@sha256).
#   * Ubuntu archive: pinned to a snapshot.ubuntu.com timestamp. Every package
#     is resolved from that one signed point-in-time archive, so versions are
#     fixed and apt verifies them against the signed Release metadata.
#   * LLVM 21: exact package version asserted after install (fails closed).
#   * apt.llvm.org (24.04 only): signing key pinned by sha256 and fingerprint.

# One snapshot timestamp for all releases. Must be newer than the base images.
UBUNTU_SNAPSHOT=20261003T120000Z

# ubuntu:24.04 (noble)
UBUNTU_2404_IMAGE=ubuntu:24.04@sha256:a853f94d226358a79c740cfc7bce0c289748f3fe3488d921d038ccd752c61b60
UBUNTU_2404_CODENAME=noble
# Ubuntu 24.04 has no LLVM 21 in the distro archive, so it comes from apt.llvm.org.
UBUNTU_2404_LLVM_REPO=https://apt.llvm.org/noble/
UBUNTU_2404_LLVM_SUITE=llvm-toolchain-noble-21
UBUNTU_2404_LLVM_VERSION='1:21.1.8~++20251221032922+2078da43e25a-1~exp1~20251221153059.70'

# ubuntu:26.04 (resolute): LLVM 21 is in the distro archive.
UBUNTU_2604_IMAGE=ubuntu:26.04@sha256:3595d7fc4286a33fad0fd853a4063e654287a9c3787437d7937c94ca3f7a804e
UBUNTU_2604_CODENAME=resolute
UBUNTU_2604_LLVM_REPO=
UBUNTU_2604_LLVM_SUITE=
UBUNTU_2604_LLVM_VERSION='1:21.1.8-6ubuntu1'

# apt.llvm.org archive signing key (https://apt.llvm.org/llvm-snapshot.gpg.key)
APT_LLVM_KEY_URL=https://apt.llvm.org/llvm-snapshot.gpg.key
APT_LLVM_KEY_SHA256=8b2a587ffd672c4687e7581dad4b2f6c1bb2ad6b480cd9771ba2ff48e0b8c75d
APT_LLVM_KEY_FINGERPRINT=6084F3CF814B57C1CF12EFD515CF4D18AF4F7421
