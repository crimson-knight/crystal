# Vendors the parts of Mica that the standard library runs on by default into
# `src/crystal/mica/` (namespace `Crystal::Mica`):
#
# - `Mica::Encoding`, the default engine of `String#encode` and IO encodings
#   (see `doc/encoding_mica.md`);
# - `Mica::Deflate`, `Mica::Zlib` and `Mica::Gzip`, the default engine of
#   `Compress::Deflate`, `Compress::Gzip`, `Compress::Zlib`, `Compress::Zip`
#   and `Digest::CRC32`/`Digest::Adler32` (see `doc/compress_mica.md`).
#
# Usage:
#
#     crystal run scripts/vendor_crystal_mica.cr -- path/to/mica/checkout
#
# The checkout must have `PINNED_COMMIT` checked out. The script checks the
# commit and its tree hash against the pins below (a mismatch stops it), then
# copies the two components and the `Mica::Core` files they use, moves every
# file from the top-level `Mica` namespace into `Crystal::Mica` (so an
# application can still require the mica shard at any version without the two
# copies reopening each other), and writes `src/crystal/mica/VENDORED.md` with
# the sha256 of every vendored file.
#
# To move to a new Mica commit, update both pins, run the script, and run
# `spec/std/string_spec.cr`, `spec/std/io/io_spec.cr`,
# `spec/std/http/request_spec.cr`, `spec/std/compress/`,
# `spec/std/digest/crc32_spec.cr`, `spec/std/digest/adler32_spec.cr` and
# `spec/std/http/`, and again with `-Duse_libiconv -Duse_libz`.

require "digest/sha256"
require "file_utils"

PINNED_COMMIT = "8a1bea29578049ffa52fcaa8f09362c9f5fdf0e1"
PINNED_TREE   = "bb42dea60c0f96297446c48c07204859453cc594"

# The parts of `Mica::Core` each component uses, in require order. The
# encoding engine loads with `String`, before most of the standard library,
# so it takes only the two it needs.
CORE_FILES_OF = {
  "encoding" => %w(position error),
  "deflate"  => %w(position error excerpt work_budget),
}

# The compression files outside `src/mica/deflate/`.
COMPRESSION_FILES = %w(zlib.cr gzip.cr)

TARGET = File.expand_path("../src/crystal/mica", __DIR__)

def git(checkout : String, *args : String) : String
  output = IO::Memory.new
  status = Process.run("git", ["-C", checkout] + args.to_a, output: output, error: Process::Redirect::Inherit)
  abort "git #{args.join(' ')} failed in #{checkout}" unless status.success?
  output.to_s.strip
end

# Moves a Mica source file from `Mica` to `Crystal::Mica`. Every top-level
# declaration in Mica opens `module Mica` or `module Mica::...`, and the only
# fully qualified references are `::Mica::...`; bare `Mica::...` references
# resolve through the enclosing namespace, so they need no change.
def move_namespace(source : String) : String
  source.lines(chomp: false).map do |line|
    if line.starts_with?("module Mica") || line.starts_with?("class Mica") || line.starts_with?("struct Mica")
      line.sub(" Mica", " Crystal::Mica")
    else
      line.gsub("::Mica::", "::Crystal::Mica::")
    end
  end.join
end

checkout = ARGV[0]? || abort "usage: crystal run scripts/vendor_crystal_mica.cr -- path/to/mica/checkout"

commit = git(checkout, "rev-parse", "HEAD")
abort "#{checkout} is at #{commit}, expected #{PINNED_COMMIT}" unless commit == PINNED_COMMIT
tree = git(checkout, "rev-parse", "HEAD^{tree}")
abort "tree #{tree} does not match the pinned tree #{PINNED_TREE}" unless tree == PINNED_TREE
dirty = git(checkout, "status", "--porcelain", "--untracked-files=no", "--", "src")
abort "#{checkout}/src has local changes" unless dirty.empty?

FileUtils.rm_rf(TARGET)
Dir.mkdir_p(TARGET)

list_of_vendored_files = [] of String

copy = ->(from : String, to : String) do
  destination = File.join(TARGET, to)
  Dir.mkdir_p(File.dirname(destination))
  File.write(destination, move_namespace(File.read(File.join(checkout, from))))
  list_of_vendored_files << to
end

CORE_FILES_OF.values.flatten.uniq.each { |name| copy.call("src/mica/core/#{name}.cr", "core/#{name}.cr") }
{"encoding", "deflate"}.each do |component|
  Dir.glob(File.join(checkout, "src/mica/#{component}/**/*.cr")).sort!.each do |path|
    relative = path.lchop(File.join(checkout, "src/mica/"))
    copy.call("src/mica/#{relative}", relative)
  end
end
COMPRESSION_FILES.each { |name| copy.call("src/mica/#{name}", name) }

mica_version = File.read(File.join(checkout, "src/mica.cr"))[/VERSION = "([^"]+)"/, 1]? || abort "no VERSION in src/mica.cr"
File.write(File.join(TARGET, "version.cr"), String.build do |io|
  io << "# Generated by scripts/vendor_crystal_mica.cr.\n\n"
  io << "# :nodoc:\nmodule Crystal::Mica\n  VERSION = " << mica_version.inspect << "\n  COMMIT  = " << PINNED_COMMIT.inspect << "\nend\n"
end)
list_of_vendored_files << "version.cr"

# The upstream entry points require `./core/...` (or all of `./core`) from
# beside `src/mica/`; the vendored ones require the version and the core
# files copied here.
{"encoding", "deflate"}.each do |component|
  entry = move_namespace(File.read(File.join(checkout, "src/mica/#{component}.cr")))
  core_requires = CORE_FILES_OF[component].map { |name| %(require "./core/#{name}"\n) }.join
  entry = entry.lines(chomp: false).reject { |line| line.starts_with?(%(require "./core)) }.join.lstrip('\n')
  File.write(File.join(TARGET, "#{component}.cr"), String.build do |io|
    io << "# Generated by scripts/vendor_crystal_mica.cr from Mica's src/mica/" << component << ".cr.\n\n"
    io << %(require "./version"\n) << core_requires << "\n"
    io << entry
  end)
  list_of_vendored_files << "#{component}.cr"
end

FileUtils.cp(File.join(checkout, "LICENSE"), File.join(TARGET, "LICENSE"))
list_of_vendored_files << "LICENSE"

File.write(File.join(TARGET, "VENDORED.md"), String.build do |io|
  io << "# Vendored Mica (Encoding and DEFLATE)\n\n"
  io << "Generated by `scripts/vendor_crystal_mica.cr`; do not edit these files by hand.\n\n"
  io << "- Source: https://github.com/amberframework/mica\n"
  io << "- Version: #{mica_version}\n"
  io << "- Commit: #{PINNED_COMMIT}\n"
  io << "- Tree: #{PINNED_TREE}\n"
  io << "- Namespace: `Mica` moved to `Crystal::Mica`\n\n"
  io << "| File | sha256 |\n|---|---|\n"
  list_of_vendored_files.sort.each do |name|
    io << "| `" << name << "` | " << Digest::SHA256.hexdigest(File.read(File.join(TARGET, name))) << " |\n"
  end
end)

puts "Vendored #{list_of_vendored_files.size} files from Mica #{PINNED_COMMIT} into #{TARGET}"
