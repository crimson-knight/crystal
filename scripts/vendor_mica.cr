# Vendors the Mica regex engine into `src/regex/mica/` for the default
# Regex engine (see `doc/regex_mica.md`).
#
# Usage:
#
#     crystal run scripts/vendor_mica.cr -- path/to/mica/checkout
#
# The checkout must have `PINNED_COMMIT` checked out. The script checks the
# commit and its tree hash against the pins below (a mismatch stops it), then
# copies the regex engine and the parts of `Mica::Core` it uses, moves every
# file from the top-level `Mica` namespace into `Regex::Mica` (so an
# application can still require the mica shard at any version without the two
# copies reopening each other), and writes `src/regex/mica/VENDORED.md` with
# the sha256 of every vendored file.
#
# To move to a new Mica release, update both pins from the tagged commit, run
# the script, and run `spec/std/regex_spec.cr`.

require "digest/sha256"
require "file_utils"

PINNED_TAG    = "v0.2.0"
PINNED_COMMIT = "a3a3fd60c1a4b5141727de7a640a2c0b8cc367d7"
PINNED_TREE   = "1a0294937195d96aaf888fa30cd2dd99beaff98b"

# The parts of `Mica::Core` the regex engine uses, in require order.
CORE_FILES = %w(position error excerpt work_budget utf8 byte_search byte_scan)

# `src/mica/regex/static/` holds the programs behind the `Mica::Regex.static`
# macro, which runs them while an application builds. The stdlib adapter
# compiles patterns at run time, so they are not vendored.
SKIPPED_REGEX_DIRECTORIES = %w(static)

TARGET = File.expand_path("../src/regex/mica", __DIR__)

def git(checkout : String, *args : String) : String
  output = IO::Memory.new
  status = Process.run("git", ["-C", checkout] + args.to_a, output: output, error: Process::Redirect::Inherit)
  abort "git #{args.join(' ')} failed in #{checkout}" unless status.success?
  output.to_s.strip
end

# Moves a Mica source file from `Mica` to `Regex::Mica`. Every top-level
# declaration in Mica opens `module Mica` or `module Mica::...`, and the only
# fully qualified references are `::Mica::...`; bare `Mica::...` references
# resolve through the enclosing namespace, so they need no change.
def move_namespace(source : String) : String
  source.lines(chomp: false).map do |line|
    if line.starts_with?("module Mica") || line.starts_with?("class Mica") || line.starts_with?("struct Mica")
      line.sub(" Mica", " Regex::Mica")
    else
      line.gsub("::Mica::", "::Regex::Mica::")
    end
  end.join
end

checkout = ARGV[0]? || abort "usage: crystal run scripts/vendor_mica.cr -- path/to/mica/checkout"

commit = git(checkout, "rev-parse", "HEAD")
abort "#{checkout} is at #{commit}, expected #{PINNED_COMMIT} (#{PINNED_TAG})" unless commit == PINNED_COMMIT
tree = git(checkout, "rev-parse", "HEAD^{tree}")
abort "tree #{tree} does not match the pinned tree #{PINNED_TREE}" unless tree == PINNED_TREE
dirty = git(checkout, "status", "--porcelain", "--untracked-files=no", "--", "src")
abort "#{checkout}/src has local changes" unless dirty.empty?

FileUtils.rm_rf(TARGET)
Dir.mkdir_p(TARGET)

list_of_vendored_files = [] of String

copy = ->(from : String, to : String) do
  destination = File.join(TARGET, to)
  Dir.mkdir_p(File.dirname(destination))
  File.write(destination, move_namespace(File.read(File.join(checkout, from))))
  list_of_vendored_files << to
end

CORE_FILES.each { |name| copy.call("src/mica/core/#{name}.cr", "core/#{name}.cr") }
copy.call("src/mica/regex.cr", "regex.cr")
Dir.glob(File.join(checkout, "src/mica/regex/**/*.cr")).sort!.each do |path|
  relative = path.lchop(File.join(checkout, "src/mica/"))
  next if SKIPPED_REGEX_DIRECTORIES.any? { |directory| relative.starts_with?("regex/#{directory}/") }
  copy.call("src/mica/#{relative}", relative)
end

# The upstream `regex.cr` requires `./core`; the vendored `core.cr` requires
# only the files above, and carries the version from the upstream `mica.cr`.
mica_version = File.read(File.join(checkout, "src/mica.cr"))[/VERSION = "([^"]+)"/, 1]? || abort "no VERSION in src/mica.cr"
abort "src/mica.cr says #{mica_version}, expected #{PINNED_TAG}" unless "v#{mica_version}" == PINNED_TAG
File.write(File.join(TARGET, "core.cr"), String.build do |io|
  io << "# Generated by scripts/vendor_mica.cr: the parts of Mica::Core the regex engine uses.\n\n"
  io << "# :nodoc:\nmodule Regex::Mica\n  VERSION = " << mica_version.inspect << "\nend\n\n"
  io << "# :nodoc:\nmodule Regex::Mica::Core\nend\n\n"
  CORE_FILES.each { |name| io << %(require "./core/#{name}"\n) }
end)
list_of_vendored_files << "core.cr"

FileUtils.cp(File.join(checkout, "LICENSE"), File.join(TARGET, "LICENSE"))
list_of_vendored_files << "LICENSE"

File.write(File.join(TARGET, "VENDORED.md"), String.build do |io|
  io << "# Vendored Mica\n\n"
  io << "Generated by `scripts/vendor_mica.cr`; do not edit these files by hand.\n\n"
  io << "- Source: https://github.com/amberframework/mica\n"
  io << "- Tag: #{PINNED_TAG}\n"
  io << "- Commit: #{PINNED_COMMIT}\n"
  io << "- Tree: #{PINNED_TREE}\n"
  io << "- Namespace: `Mica` moved to `Regex::Mica`\n\n"
  io << "| File | sha256 |\n|---|---|\n"
  list_of_vendored_files.sort.each do |name|
    io << "| `" << name << "` | " << Digest::SHA256.hexdigest(File.read(File.join(TARGET, name))) << " |\n"
  end
end)

puts "Vendored #{list_of_vendored_files.size} files from Mica #{PINNED_TAG} into #{TARGET}"
