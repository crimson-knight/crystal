# Vendors Mica's character-set conversion (`Mica::Encoding`) into
# `src/crystal/mica/` for the default string and IO encoding engine (see
# `doc/encoding_mica.md`).
#
# Usage:
#
#     crystal run scripts/vendor_mica_encoding.cr -- path/to/mica/checkout
#
# The checkout must have `PINNED_COMMIT` checked out. The script checks the
# commit and its tree hash against the pins below (a mismatch stops it), then
# copies the encoding core and the two `Mica::Core` files it uses, moves every
# file from the top-level `Mica` namespace into `Crystal::Mica` (so an application
# can still require the mica shard at any version without the two copies
# reopening each other), and writes `src/crystal/mica/VENDORED.md` with the sha256
# of every vendored file.
#
# To move to a new Mica commit, update both pins, run the script, and run
# `spec/std/string_spec.cr`, `spec/std/io/io_spec.cr` and
# `spec/std/http/request_spec.cr`, and again with `-Duse_libiconv`.

require "digest/sha256"
require "file_utils"

PINNED_COMMIT = "88d6ff9cd34cd344e2190fbc501b33ae309b1e34"
PINNED_TREE   = "45d2c431fb8c354131a0305d59cac7eeb5a7c918"

# The parts of `Mica::Core` the encoding core uses, in require order.
CORE_FILES = %w(position error)

TARGET = File.expand_path("../src/crystal/mica", __DIR__)

def git(checkout : String, *args : String) : String
  output = IO::Memory.new
  status = Process.run("git", ["-C", checkout] + args.to_a, output: output, error: Process::Redirect::Inherit)
  abort "git #{args.join(' ')} failed in #{checkout}" unless status.success?
  output.to_s.strip
end

# Moves a Mica source file from `Mica` to `Crystal::Mica`. Every top-level
# declaration in Mica opens `module Mica` or `module Mica::...`, and the only
# fully qualified references are `::Mica::...`; bare `Mica::...` references
# resolve through the enclosing namespace, so they need no change.
def move_namespace(source : String) : String
  source.lines(chomp: false).map do |line|
    if line.starts_with?("module Mica") || line.starts_with?("class Mica") || line.starts_with?("struct Mica")
      line.sub(" Mica", " Crystal::Mica")
    else
      line.gsub("::Mica::", "::Crystal::Mica::")
    end
  end.join
end

checkout = ARGV[0]? || abort "usage: crystal run scripts/vendor_mica_encoding.cr -- path/to/mica/checkout"

commit = git(checkout, "rev-parse", "HEAD")
abort "#{checkout} is at #{commit}, expected #{PINNED_COMMIT}" unless commit == PINNED_COMMIT
tree = git(checkout, "rev-parse", "HEAD^{tree}")
abort "tree #{tree} does not match the pinned tree #{PINNED_TREE}" unless tree == PINNED_TREE
dirty = git(checkout, "status", "--porcelain", "--untracked-files=no", "--", "src")
abort "#{checkout}/src has local changes" unless dirty.empty?

FileUtils.rm_rf(TARGET)
Dir.mkdir_p(TARGET)

list_of_vendored_files = [] of String

copy = ->(from : String, to : String) do
  destination = File.join(TARGET, to)
  Dir.mkdir_p(File.dirname(destination))
  File.write(destination, move_namespace(File.read(File.join(checkout, from))))
  list_of_vendored_files << to
end

CORE_FILES.each { |name| copy.call("src/mica/core/#{name}.cr", "core/#{name}.cr") }
Dir.glob(File.join(checkout, "src/mica/encoding/**/*.cr")).sort!.each do |path|
  relative = path.lchop(File.join(checkout, "src/mica/"))
  copy.call("src/mica/#{relative}", relative)
end

# The upstream entry point requires `./core/position` and `./core/error`
# from beside `src/mica/`; the vendored one requires the copies here.
mica_version = File.read(File.join(checkout, "src/mica.cr"))[/VERSION = "([^"]+)"/, 1]? || abort "no VERSION in src/mica.cr"
entry = move_namespace(File.read(File.join(checkout, "src/mica/encoding.cr")))
File.write(File.join(TARGET, "encoding.cr"), String.build do |io|
  io << "# Generated by scripts/vendor_mica_encoding.cr from Mica's src/mica/encoding.cr.\n\n"
  io << "# :nodoc:\nmodule Crystal::Mica\n  VERSION = " << mica_version.inspect << "\n  COMMIT  = " << PINNED_COMMIT.inspect << "\nend\n\n"
  io << entry
end)
list_of_vendored_files << "encoding.cr"

FileUtils.cp(File.join(checkout, "LICENSE"), File.join(TARGET, "LICENSE"))
list_of_vendored_files << "LICENSE"

File.write(File.join(TARGET, "VENDORED.md"), String.build do |io|
  io << "# Vendored Mica (Encoding)\n\n"
  io << "Generated by `scripts/vendor_mica_encoding.cr`; do not edit these files by hand.\n\n"
  io << "- Source: https://github.com/amberframework/mica\n"
  io << "- Version: #{mica_version}\n"
  io << "- Commit: #{PINNED_COMMIT}\n"
  io << "- Tree: #{PINNED_TREE}\n"
  io << "- Namespace: `Mica` moved to `Crystal::Mica`\n\n"
  io << "| File | sha256 |\n|---|---|\n"
  list_of_vendored_files.sort.each do |name|
    io << "| `" << name << "` | " << Digest::SHA256.hexdigest(File.read(File.join(TARGET, name))) << " |\n"
  end
end)

puts "Vendored #{list_of_vendored_files.size} files from Mica #{PINNED_COMMIT} into #{TARGET}"
